[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
; a reload would recreate the game node and drop the running engine session
reloadable = false

[libraries]

linux.debug.x86_64 = "res://../rust/target/debug/librenethack_gd.so"
linux.release.x86_64 = "res://../rust/target/release/librenethack_gd.so"
macos.debug = "res://../rust/target/debug/librenethack_gd.dylib"
macos.release = "res://../rust/target/release/librenethack_gd.dylib"

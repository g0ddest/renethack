; renethack Godot project: the whole client is the GDExtension renethack-gd
; (client/rust/renethack-gd); this project only holds the main scene.

config_version=5

[application]

config/name="renethack"
config/description="NetHack 5.0 with a modern presentation"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")
; the hero's "@" on a medallion (tools/app_icon.py, `make app-icon`); the
; native icons are what the Dock and the taskbar show
config/icon="res://icon.png"
config/macos_native_icon="res://icon.icns"
config/windows_native_icon="res://icon.ico"
; the boot splash is the title's own colour, without the engine's logo:
; the game keeps it up for its first frames (game.rs, the start-up veil)
boot_splash/bg_color=Color(0.043137256, 0.03529412, 0.03137255, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; Forward+ for SSAO, SSIL and volumetric fog; without Vulkan/Metal/D3D12
; Godot falls back to the compatibility renderer by itself
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/ssao/quality=2
environment/ssao/half_size=true
environment/ssil/quality=2
environment/ssil/half_size=true
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3

[shader_globals]

; the map's surface shader (map_surface.gdshader): walls and rock between
; the eye and the hero dither away
hero_pos={
"type": "vec3",
"value": Vector3(0, -100, 0)
}
eye_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
; how much the floors of the branch crack and glow from below (Gehennom)
branch_cracks={
"type": "float",
"value": 0.0
}

[renethack]

; nh-engine, recover and data/ (RENETHACK_ENGINE_DIR overrides it)
engine_dir="res://../../engine/build"
; the order tick in milliseconds, 150-500: one engine action per tick
; while an order runs (RENETHACK_TICK_MS overrides it)
tick_ms=300

[importer_defaults]

; the art is 1K photo textures seen from afar: mipmaps, and compressed on
; the GPU (S3TC/BPTC on desktop)
texture={
"compress/mode": 2,
"mipmaps/generate": true
}

; renethack Godot project: the whole client is the GDExtension renethack-gd
; (client/rust/renethack-gd); this project only holds the main scene.

config_version=5

[application]

config/name="renethack"
config/description="NetHack 5.0 with a modern presentation"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; Forward+ for SSAO, SSIL and volumetric fog; without Vulkan/Metal/D3D12
; Godot falls back to the compatibility renderer by itself
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/ssao/quality=2
environment/ssao/half_size=true
environment/ssil/quality=2
environment/ssil/half_size=true
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3

[renethack]

; nh-engine, recover and data/ (RENETHACK_ENGINE_DIR overrides it)
engine_dir="res://../../engine/build"
; the order tick in milliseconds, 150-500: one engine action per tick
; while an order runs (RENETHACK_TICK_MS overrides it)
tick_ms=300

[importer_defaults]

; the art is 1K photo textures seen from afar: mipmaps, and compressed on
; the GPU (S3TC/BPTC on desktop)
texture={
"compress/mode": 2,
"mipmaps/generate": true
}

; renethack Godot project: the whole client is the GDExtension renethack-gd
; (client/rust/renethack-gd); this project only holds the main scene.

config_version=5

[application]

config/name="renethack"
config/description="NetHack 5.0 with a modern presentation"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[renethack]

; nh-engine, recover and data/ (RENETHACK_ENGINE_DIR overrides it)
engine_dir="res://../../engine/build"

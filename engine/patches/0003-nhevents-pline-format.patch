@@ -0,0 +1,24 @@
+/* NetHack 5.0	nhevents.h */
+/* renethack: observation hooks for a front end */
+/* NetHack may be freely redistributed.  See license for details. */
+
+#ifndef NHEVENTS_H
+#define NHEVENTS_H
+
+#include <stdarg.h>
+
+/* What the core does, for a front end that wants to know more than the
+ * window port is told.  A hook only observes: it must not change the game,
+ * draw on the RNG, or call pline() or the display.  Every hook is null
+ * unless the front end sets it, so the core alone calls none.
+ */
+struct nhevents_procs {
+    /* a message about to be formatted: vpline()'s format and arguments */
+    void (*pline_format)(const char *fmt, va_list args);
+};
+
+extern struct nhevents_procs nhevents;
+
+extern void nhevents_pline_format(const char *, va_list);
+
+#endif /* NHEVENTS_H */
--- /dev/null
+++ b/src/nhevents.c
@@ -0,0 +1,22 @@
+/* NetHack 5.0	nhevents.c */
+/* renethack: observation hooks for a front end (see nhevents.h) */
+/* NetHack may be freely redistributed.  See license for details. */
+
+#include "hack.h"
+#include "nhevents.h"
+
+struct nhevents_procs nhevents = { 0 };
+
+/* the hook gets a copy of the arguments: vpline() goes on to format the
+   message from them */
+void
+nhevents_pline_format(const char *fmt, va_list args)
+{
+    va_list copy;
+
+    if (!nhevents.pline_format)
+        return;
+    va_copy(copy, args);
+    (*nhevents.pline_format)(fmt, copy);
+    va_end(copy);
+}
